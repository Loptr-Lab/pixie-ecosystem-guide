# Non-secret template for the EXISTING Companion Railway service only.
NODE_ENV=production
PIXIE_LOCAL_OWNER=0
# Machine-only MCP credential, not browser sign-in and not an implicit workspace grant. Never commit a value.
PIXIE_MCP_TOKEN=
# Optional, independently verified administrator DID (does not restrict other sign-ins or grant access to their projects).
PIXIE_OWNER_DID=
# Separate 32 random bytes as 64 lowercase hex characters; configure privately.
# Not the MCP token. Keep stable with the encrypted identity file across restarts.
PIXIE_SESSION_SECRET=
# Attach the existing service's persistent volume at /data.
# Railway supplies RAILWAY_VOLUME_MOUNT_PATH after attachment; do not fake a mount.
PIXIE_DATA_FILE=/data/private/workspace.json
RAILPACK_NODE_VERSION=22
# Railway supplies PORT; production launcher binds 0.0.0.0 on that port.
# Optional model settings remain unset until separately configured privately:
# PIXIE_MODEL_URL=
# PIXIE_MODEL_API_KEY=
# PIXIE_MODEL_NAME=
