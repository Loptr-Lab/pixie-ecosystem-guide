# Non-secret template for the EXISTING Companion Railway service only.
NODE_ENV=production
PIXIE_LOCAL_OWNER=0
# Generate privately in Railway; at least 32 random characters. Never commit a value.
PIXIE_MCP_TOKEN=
# Attach the existing service's persistent volume at /data.
# Railway supplies RAILWAY_VOLUME_MOUNT_PATH after attachment; do not fake a mount.
PIXIE_DATA_FILE=/data/private/workspace.json
RAILPACK_NODE_VERSION=22
# Railway supplies PORT; production launcher binds 0.0.0.0 on that port.
# Optional model settings remain unset until separately configured privately:
# PIXIE_MODEL_URL=
# PIXIE_MODEL_API_KEY=
# PIXIE_MODEL_NAME=
